# 默认忽略的文件
/shelf/
/workspace.xml
# 已忽略包含查询文件的默认文件夹
/queries/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
# 基于编辑器的 HTTP 客户端请求
/httpRequests/
# =========================
# 1. 编译输出与中间文件 (Keil & GCC)
# =========================
# 忽略 Keil 生成的列表和对象文件夹 [cite: 17, 18]
Listings/
Objects/
USER/Listings/
USER/Objects/

# 忽略具体后缀的中间文件 [cite: 19, 20, 26]
*.o
*.d
*.crf
*.axf
*.hex
*.lnp
*.sct
*.dep
*.map
*.lst
*.htm
*.build_log.htm

# =========================
# 2. IDE 配置文件 (CLion & Keil)
# =========================

# 忽略 Keil 用户特定的配置 (布局、调试设置等)
*.uvguix.*
*.uvoptx

# 忽略调试器日志和临时设置
JLinkLog.txt
JLinkSettings.ini
DebugConfig/

# 忽略 Understand 静态分析数据库
*.und/
# =========================
# 3. CMake 构建目录
# =========================
# 忽略 CMake 产生的构建中间产物 [cite: 4, 7]
cmake-build-debug/
cmake-build-release/
CMakeFiles/
CMakeCache.txt
build.ninja
cmake_install.cmake


